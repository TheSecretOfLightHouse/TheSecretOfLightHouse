  - {fileID: 8926484042661615220}
  - {fileID: 8926484042661615224}
  - {fileID: 8926484042661615228}
  m_OperatorName: Gold - Thick jagged motion
  m_HLSLCode: "void ElectricArcMotion(in float2 Particle, in float Time, in float3
    Tangent, in float4 Controls, out float3 Offset, out float3 Tint, out float Width)\n{\n   
    float u=Particle.x;\n    uint Ribbon=(uint)Particle.y;\n    float3 forward=normalize(Tangent+float3(0.00001,0,0));\n   
    float3 side=normalize(cross(forward,abs(forward.y)<0.9?float3(0,1,0):float3(1,0,0)));\n   
    float3 up=normalize(cross(side,forward));\n    float t=fmod(Time,60.0)*max(Controls.z,0.1);\n   
    float seed=fmod(floor(t*5.0),251.0);\n    float x=u*5.0*max(Controls.y,0.1);\n   
    float k=floor(x);\n    float a=frac(x);\n    float3 h0=frac(sin((k+seed*19.3+Ribbon*47.1)*float3(12.9898,78.233,39.425))*43758.5453)*2.0-1.0;\n   
    float3 h1=frac(sin((k+1.0+seed*19.3+Ribbon*47.1)*float3(12.9898,78.233,39.425))*43758.5453)*2.0-1.0;\n   
    float3 n=lerp(h0,h1,a);\n    float envelope=1.0;\n    float bend=sin(u*17.0+t*2.1+Ribbon*1.7)*0.20+sin(u*43.0-t+Ribbon)*0.10;\n   
    Offset=(side*(n.x*0.65+bend)+up*(n.y*0.65-bend*0.5)+forward*n.z*0.1)*max(Controls.x,0.0)*envelope;\n   
    float flicker=0.85+0.15*sin(t*19.0+u*24.0+Ribbon);\n    Tint=float3(1,1,1)*flicker;\n   
    Width=max(Controls.w,0.001)*(0.82+0.18*sin(u*29.0+t*9.0+Ribbon));\n    if(Ribbon==1u){Tint*=0.65;Width*=0.75;}\n   
    if(Ribbon==2u){Tint*=0.8;Width*=0.9;}\n    if(Ribbon==3u){Tint=float3(16.0,1.833333,0.075)*flicker;Width*=1.8;}\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunctions:
    selection: ElectricArcMotion
    selectedIndex: 0
