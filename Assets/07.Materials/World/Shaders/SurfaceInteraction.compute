#pragma kernel Prepare
#pragma kernel Flow
#pragma kernel Integrate
#pragma kernel Shift
#pragma kernel SprayUpdate
#pragma kernel ShoreSpray
#pragma kernel ContactSpray
#include "Include/OceanGerstner.hlsl"

Texture2D<float4> _Read;
Texture2D<float4> _Background;
Texture2D<float4> _Domain;
Texture2D<float4> _Obstacles;
Texture2D<float4> _SprayState;
SamplerState sampler_Read;
RWTexture2D<float4> _Write;
RWTexture2D<float4> _BackgroundWrite;
RWTexture2D<float4> _DomainWrite;
int _Resolution;
int2 _Shift;
float _CellSize;
float _Step;
float2 _Origin;

int2 Safe(int2 p) { return clamp(p,0,_Resolution-1); }
float4 State(int2 p) { return _Read[Safe(p)]; }
float4 Domain(int2 p) { return _Domain[Safe(p)]; }
float4 Background(int2 p) { return _Background[Safe(p)]; }

struct SprayParticle { float4 positionAge; float4 velocityLife; float4 sizeSeed; };
RWStructuredBuffer<SprayParticle> _SprayParticles;
RWStructuredBuffer<uint> _SprayCounter;
int _SprayCapacity;
int _SprayFrame;
float _SprayDelta;
float3 _SprayFocus;

float SprayHash(float n) { return frac(sin(n*127.1+311.7)*43758.5453); }
void EmitSpray(float3 position,float3 velocity,float seed,float size,float kind)
{
    uint slot;
    InterlockedAdd(_SprayCounter[0],1,slot);
    SprayParticle particle;
    particle.positionAge=float4(position,0);
    particle.velocityLife=float4(velocity,0.65+SprayHash(seed+7)*0.8);
    particle.sizeSeed=float4(size,seed,kind,0);
    _SprayParticles[slot%(uint)_SprayCapacity]=particle;
}

[numthreads(64,1,1)]
void SprayUpdate(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=(uint)_SprayCapacity) return;
    SprayParticle p=_SprayParticles[id.x];
    if(p.velocityLife.w<=0 || p.positionAge.w>=p.velocityLife.w) return;
    p.positionAge.w+=_SprayDelta;
    p.velocityLife.y-=_SprayDelta*9.81;
    p.velocityLife.xyz*=exp(-_SprayDelta*0.35);
    p.positionAge.xyz+=p.velocityLife.xyz*_SprayDelta;
    float2 samplePosition=(p.positionAge.xz-_Origin)/_CellSize;
    float water;
    if(all(samplePosition>=0)&&all(samplePosition<_Resolution))
    {
        int2 cell=int2(samplePosition);
        water=_Background[cell].x+_SprayState[cell].x;
    }
    else
    {
        float3 surface,normal;
        OceanGerstner_float(float3(p.positionAge.x,0,p.positionAge.z),surface,normal);
        water=surface.y;
    }
    if(p.positionAge.y<water && p.velocityLife.y<0) p.positionAge.w=p.velocityLife.w;
    _SprayParticles[id.x]=p;
}

[numthreads(64,1,1)]
void ShoreSpray(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=OCEAN_COAST_CAPACITY*OCEAN_COAST_SEGMENTS) return;
    uint island=id.x/OCEAN_COAST_SEGMENTS;
    float4 area=_OceanCoastBounds[island];
    if(area.w<=0) return;
    float4 edge=_OceanCoastEdges[id.x];
    float2 midpoint=(edge.xy+edge.zw)*0.5;
    if(distance(midpoint,_SprayFocus.xz)>42) return;
    float2 tangent=normalize(edge.zw-edge.xy);
    float2 outward=float2(tangent.y,-tangent.x);
    float width=CoastWidth(area.w,_OceanCoastProfiles[island],midpoint);
    float beach=saturate((width/area.w-0.14)/0.86);
    float rock=1-beach;
    float seed=id.x*17.13+_SprayFrame*3.73;
    float d=lerp(0.35,2.2,beach);
    float phase=CoastPhase(d,_OceanTime);
    float crest=smoothstep(0.45,0.9,sin(phase));
    float energy=0;
    for(int i=0;i<min((int)_OceanWaveCount,OCEAN_MAX_WAVES);i++) energy+=_OceanWaveB[i].x;
    float strength=saturate(energy*2);
    if(SprayHash(seed)>_SprayDelta*22*crest*strength) return;
    float2 shore=lerp(edge.xy,edge.zw,SprayHash(seed+1));
    float2 position=shore+outward*(d+(SprayHash(seed+2)-0.5)*lerp(0.4,1.6,beach));
    float h=CoastHeight(d,width,_OceanTime,0,energy);
    for(int j=0;j<8;j++)
    {
        float s=seed+j*31.7;
        float lift=lerp(1.5,3.8,rock)*(0.6+SprayHash(s+3)*0.7)*sqrt(strength);
        float2 lateral=outward*lerp(-0.7,1.3,rock)+tangent*(SprayHash(s+4)-0.5)*1.6;
        float kind=step(0.5,SprayHash(s+5));
        float size=lerp(0.018,0.055,SprayHash(s+6))*lerp(1.2,0.32,kind);
        EmitSpray(float3(position.x,h+0.025,position.y),float3(lateral.x,lift,lateral.y),s,size,kind);
    }
}

[numthreads(8,8,1)]
void ContactSpray(uint3 id:SV_DispatchThreadID)
{
    int2 p=int2(id.xy);
    if(Domain(p).x>0.5) return;
    float2 normal=float2(Domain(p+int2(1,0)).x-Domain(p-int2(1,0)).x,
        Domain(p+int2(0,1)).x-Domain(p-int2(0,1)).x);
    if(dot(normal,normal)<0.1) return;
    normal=normalize(normal);
    int2 wall=Safe(p+int2(round(normal)));
    float2 relative=Background(p).yz-Domain(wall).yz;
    float hit=max(0,dot(relative,normal)-0.08);
    float seed=p.x+p.y*127+_SprayFrame*7.13;
    if(SprayHash(seed)>min(0.7,hit*_SprayDelta*12)) return;
    float2 world=_Origin+(p+0.5)*_CellSize;
    float lift=min(3,0.6+hit*0.8);
    float2 lateral=-normal*(0.15+hit*0.25)+Domain(wall).yz*0.15;
    EmitSpray(float3(world.x,Background(p).x+0.02,world.y),float3(lateral.x,lift,lateral.y),seed,
        0.008+SprayHash(seed+3)*0.016,1);
}

float _StaticContactFoam;
float _WaveEnergy;

[numthreads(8,8,1)]
void Shift(uint3 id : SV_DispatchThreadID)
{
    int2 source = int2(id.xy) + _Shift;
    _Write[id.xy] = all(source>=0) && all(source<_Resolution) ? _Read[source] : 0;
}

[numthreads(8,8,1)]
void Prepare(uint3 id : SV_DispatchThreadID)
{
    float2 p = _Origin + (id.xy+0.5)*_CellSize;
    float3 position,normal;
    float4 coast;
    OceanGerstnerField_float(float3(p.x,0,p.y),position,normal,coast);
    float2 velocity = 0;
    for (int i=0;i<min((int)_OceanWaveCount,OCEAN_MAX_WAVES);i++)
    {
        float k = OCEAN_TWO_PI/max(0.1,_OceanWaveA[i].z);
        float phase = k*(dot(_OceanWaveA[i].xy,p)-_OceanWaveA[i].w*_OceanTime);
        velocity += _OceanWaveA[i].xy*_OceanWaveB[i].x*k*_OceanWaveA[i].w*sin(phase);
    }
    float depth = 1;
    float4 obstacle = _Obstacles[id.xy];
    if(coast.w>0)
    {
        depth = clamp(0.15+max(0,coast.z)*lerp(0.5,0.07,smoothstep(1,5,coast.w)),0.15,1);
        float fetch=max(7,coast.w);
        float blend = smoothstep(fetch*2.2,fetch*5,max(0,coast.z));
        velocity = lerp(-coast.xy*position.y*sqrt(9.81/depth),velocity,blend);
        if(coast.z<0) obstacle = float4(1,0,0,0);
    }
    _BackgroundWrite[id.xy] = float4(position.y,velocity,depth);
    _DomainWrite[id.xy] = float4(step(0.45,obstacle.x),obstacle.yz,depth);
}

[numthreads(8,8,1)]
void Flow(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    float4 s = State(p);
    float4 d = Domain(p);
    int2 right = p+int2(1,0), top=p+int2(0,1);
    float4 dr=Domain(right),dt=Domain(top);
    float2 incident = float2((Background(p).y+Background(right).y)*0.5,
        (Background(p).z+Background(top).z)*0.5);
    float2 flow = s.yz - 9.81*_Step/_CellSize*float2(State(right).x-s.x,State(top).x-s.x);
    flow *= exp(-0.45*_Step);
    if(d.x>0.5 || dr.x>0.5) flow.x = (d.x>0.5?d.y:dr.y)-incident.x;
    if(d.x>0.5 || dt.x>0.5) flow.y = (d.x>0.5?d.z:dt.z)-incident.y;
    _Write[p] = float4(s.x,clamp(flow,-2.5,2.5),s.w);
}

float Impact(int2 p,int2 offset,float2 normal)
{
    float4 wall=Domain(p+offset);
    float2 relative = Background(p).yz - wall.yz;
    return wall.x*max(0,dot(relative,normal)-0.035);
}

// Walls that are not moving (rocks, piers, a moored hull) keep a lapping foam ring.
float StaticWall(int2 p)
{
    float4 wall=Domain(p);
    return wall.x*step(dot(wall.yz,wall.yz),0.0025);
}

float StaticContactFoam(int2 p)
{
    float near1=max(max(StaticWall(p+int2(1,0)),StaticWall(p-int2(1,0))),max(StaticWall(p+int2(0,1)),StaticWall(p-int2(0,1))));
    float near2=max(max(StaticWall(p+int2(2,0)),StaticWall(p-int2(2,0))),max(StaticWall(p+int2(0,2)),StaticWall(p-int2(0,2))));
    float lap=saturate(0.5+Background(p).x*6);
    return _StaticContactFoam*max(near1,near2*0.5)*lap*(0.4+0.6*saturate(_WaveEnergy*5));
}

[numthreads(8,8,1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    int2 p=int2(id.xy);
    float4 d=Domain(p);
    if(d.x>0.5) { _Write[p]=0; return; }
    float4 s=State(p);
    float rightDepth = (d.w+Domain(p+int2(1,0)).w)*0.5;
    float leftDepth = (d.w+Domain(p-int2(1,0)).w)*0.5;
    float topDepth = (d.w+Domain(p+int2(0,1)).w)*0.5;
    float bottomDepth = (d.w+Domain(p-int2(0,1)).w)*0.5;
    float divergence = (rightDepth*s.y-leftDepth*State(p-int2(1,0)).y
        +topDepth*s.z-bottomDepth*State(p-int2(0,1)).z)/_CellSize;
    float height = s.x - _Step*divergence;
    float edge = min(min(p.x,p.y),min(_Resolution-1-p.x,_Resolution-1-p.y));
    float sponge = exp(-_Step*(0.5+12*(1-smoothstep(0,12,edge))));
    float2 velocity = Background(p).yz + (s.yz+float2(State(p-int2(1,0)).y,State(p-int2(0,1)).z))*0.5;
    float2 uv = (p+0.5-velocity*_Step/_CellSize)/_Resolution;
    float foam = _Read.SampleLevel(sampler_Read,uv,0).w*exp(-_Step*1.6);
    if(Domain(int2(uv*_Resolution)).x>0.5) foam=0;
    float impact = Impact(p,int2(1,0),float2(1,0))+Impact(p,int2(-1,0),float2(-1,0))
        +Impact(p,int2(0,1),float2(0,1))+Impact(p,int2(0,-1),float2(0,-1));
    float breaking = max(0,abs(divergence)-0.25)*0.2;
    float surf = saturate((Background(p).x-0.012)*40)*(1-smoothstep(0.3,0.65,d.w));
    foam = saturate(foam + _Step*(impact*5+breaking+surf*1.8+StaticContactFoam(p)*3));
    _Write[p] = float4(clamp(height,-0.14,0.14)*sponge,s.yz*sponge,foam*sponge);
}
